# ============================================
# FRONTEND (Next.js) - copia este archivo a .env.local
# ============================================

# Fuente de datos:
#   mock → datos en memoria, no necesita backend (por defecto; ideal para demos y Vercel)
#   real → consume el backend Express (necesita NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_MODE=mock

# URL del backend (sin "/api" al final). Solo se usa con NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_URL=http://localhost:3002
